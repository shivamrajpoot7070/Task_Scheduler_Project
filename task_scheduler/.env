# ===============================
# SERVER
# ===============================
NODE_ENV=development
PORT=5000

# ===============================
# POSTGRESQL CONFIG
# ===============================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=scheduler_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=12345ab6

# Optional (for cloud DB like Neon/Supabase)
DATABASE_URL=postgresql://postgres:12345ab6@localhost:5432/scheduler_db

# ===============================
# REDIS CONFIG (Upstash TCP)
# ===============================
REDIS_URL=rediss://default:gQAAAAAAAYyTAAIocDFlNTUxZDA2OGM2ZjA0NmViYmEzN2UxMGQ3MGVlODAyNHAxMTAxNTIz@optimal-terrier-101523.upstash.io:6379

# ===============================
# TASK SYSTEM CONFIG
# ===============================
SCHEDULER_INTERVAL_MS=1000        # Poll DB every 1 sec
MAX_RETRIES=3                     # Retry failed tasks
RETRY_BASE_DELAY_MS=5000          # 5 sec base delay (for backoff)

# ===============================
# LOGGING
# ===============================
LOG_LEVEL=info